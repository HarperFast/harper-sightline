{
	"name": "sightline",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"imports": {
		"#harper": {
			"types": "./types/harperImportsShim.d.ts",
			"test": "./test/harperStub.ts",
			"default": "harper"
		}
	},
	"scripts": {
		"test": "node --test --conditions=test 'test/*.test.ts'",
		"coverage": "node --test --experimental-test-coverage --conditions=test 'test/*.test.ts'",
		"dev": "vite web",
		"build": "vite build web",
		"typecheck": "tsc --noEmit",
		"lint:required": "oxlint",
		"format:write": "prettier --write .",
		"format:check": "prettier --check .",
		"deploy": "node scripts/deploy.mjs",
		"smoke": "node scripts/smoke.mjs",
		"loadtest": "node scripts/loadtest.mjs",
		"contract:gen": "node scripts/gen-contract.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"happy-dom": "^20.11.2",
		"oxlint": "^1.77.0",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2",
		"vite": "^8.2.0"
	}
}
