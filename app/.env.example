# Harper Fabric instance — operations API (used by scripts/deploy.mjs, set_secret)
HARPER_OPS_URL=https://<your-instance>:9925/
HARPER_USER=<user>
HARPER_PASS=<password>

# Public base URL of the deployed component / Shopify App URL (used by scripts/smoke.mjs)
SIGHTLINE_BASE=https://<your-instance>

# Shopify app — client_id (API key) is PUBLIC.
# The app SECRET is NEVER stored here: it lives in Harper native secrets
# (set_secret SHOPIFY_API_SECRET, granted to the "sightline" component).
SHOPIFY_API_KEY=<client_id>

# Dev instance with a self-signed/edge cert only. Do not set in production.
NODE_TLS_REJECT_UNAUTHORIZED=0
