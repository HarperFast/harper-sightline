{
	"version": "v1",
	"windowDays": 7,
	"pagination": {
		"style": "cursor",
		"defaultLimit": 25,
		"maxLimit": 100
	},
	"resources": {
		"session": {
			"path": "/api/v1/session",
			"fields": [
				"shop",
				"user",
				"capabilities",
				"timezone",
				"support"
			]
		},
		"setup": {
			"path": "/api/v1/setup",
			"fields": [
				"shop",
				"complete",
				"steps",
				"eventsObserved",
				"action"
			]
		},
		"summary": {
			"path": "/api/v1/summary",
			"fields": [
				"shop",
				"windowDays",
				"events",
				"orders",
				"aging",
				"findings",
				"recorder",
				"reconciliation",
				"activity",
				"integrity"
			]
		},
		"events": {
			"path": "/api/v1/events",
			"item": [
				"eventId",
				"domain",
				"topic",
				"resourceId",
				"sku",
				"quantity",
				"fulfillableItemCount",
				"orderName",
				"totalPrice",
				"currency",
				"locationId",
				"hasTracking",
				"trackingCompany",
				"shipmentStatus",
				"state",
				"source",
				"occurredAt",
				"receivedAt",
				"skus"
			],
			"paginated": true,
			"filters": [
				"domain",
				"topic",
				"resourceId",
				"sku",
				"source",
				"state",
				"since",
				"until",
				"cursor",
				"limit"
			]
		},
		"eventDetail": {
			"path": "/api/v1/events/:id",
			"fields": [
				"eventId",
				"domain",
				"topic",
				"resourceId",
				"sku",
				"quantity",
				"fulfillableItemCount",
				"orderName",
				"totalPrice",
				"currency",
				"locationId",
				"hasTracking",
				"trackingCompany",
				"shipmentStatus",
				"state",
				"source",
				"occurredAt",
				"receivedAt",
				"skus",
				"relatedEventIds",
				"affectedProjection",
				"affectedFinding",
				"inventorySku",
				"productTitle",
				"locationName"
			]
		},
		"flows": {
			"path": "/api/v1/flows",
			"fields": [
				"shop",
				"windowDays",
				"lanes"
			]
		},
		"findings": {
			"path": "/api/v1/findings",
			"item": [
				"id",
				"orderId",
				"detector",
				"ruleVersion",
				"status",
				"detectedAt",
				"resolvedAt",
				"evidenceEventIds",
				"paidAt",
				"deadline",
				"orderName"
			],
			"paginated": true,
			"filters": [
				"status",
				"detector",
				"cursor",
				"limit"
			]
		},
		"findingDetail": {
			"path": "/api/v1/findings/:id",
			"fields": [
				"id",
				"orderId",
				"detector",
				"ruleVersion",
				"status",
				"detectedAt",
				"resolvedAt",
				"evidenceEventIds",
				"description",
				"projection",
				"expectation"
			]
		},
		"orders": {
			"path": "/api/v1/orders",
			"item": [
				"orderId",
				"orderName",
				"state",
				"paidAt",
				"fulfilledAt",
				"cancelledAt",
				"fullyRefundedAt",
				"fulfillmentFailedAt",
				"hasTracking",
				"trackingCompany",
				"orderTotal",
				"currency",
				"lastEventAt",
				"ageHours"
			],
			"paginated": true,
			"filters": [
				"state",
				"minAgeHours",
				"maxAgeHours",
				"sort",
				"cursor",
				"limit"
			]
		},
		"orderDetail": {
			"path": "/api/v1/orders/:orderId",
			"fields": [
				"orderId",
				"orderName",
				"state",
				"paidAt",
				"fulfilledAt",
				"cancelledAt",
				"fullyRefundedAt",
				"fulfillmentFailedAt",
				"hasTracking",
				"trackingCompany",
				"orderTotal",
				"currency",
				"lastEventAt",
				"ageHours",
				"requiresFulfillment",
				"events",
				"findings"
			]
		},
		"export": {
			"path": "/api/v1/export/:kind.csv",
			"kinds": [
				"events",
				"findings",
				"orders"
			],
			"format": "text/csv",
			"maxRows": 5000
		},
		"privacy": {
			"path": "/api/v1/privacy",
			"fields": [
				"shop",
				"retentionDays",
				"storesCustomerPii",
				"scopes",
				"dataCategories",
				"excludedFields",
				"deletion",
				"footprint",
				"webhooks",
				"reconciliation"
			]
		}
	}
}
